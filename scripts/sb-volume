#!/bin/sh

# Config files
ICON_FILE="$HOME/.config/audio-switch/icon_list"
BLOCK_FILE="$HOME/.config/audio-switch/block_list"

# Function to get icon from icon list
get_icon() {
    local sink_name="$1"
    if [ -f "$ICON_FILE" ]; then
        awk -v sink="$sink_name" '
            $0 == sink {getline; getline; print; next}
            {next}
        ' "$ICON_FILE"
    else
        echo "🔊" # Default icon if no icon file exists
    fi
}

# Function to check if sink is blocked
is_blocked() {
    local sink_name="$1"
    if [ -f "$BLOCK_FILE" ]; then
        grep -q "^${sink_name}$" "$BLOCK_FILE"
        return $?
    fi
    return 1
}

# Function to switch to next available sink
switch_to_next_sink() {
    # Get current default sink
    current_sink=$(pactl get-default-sink)

    # Create a temporary file to store the sinks list
    tmp_sinks="/tmp/available_sinks.$$"

    # Get list of sinks and store in temporary file
    pactl list short sinks | while read -r id name driver format state; do
        if ! is_blocked "$name"; then
            echo "$name"
        fi
    done > "$tmp_sinks"

    # Find the next sink
    found_next=0
    while read -r sink; do
        if [ $found_next -eq 1 ]; then
            next_sink="$sink"
            break
        fi
        if [ "$sink" = "$current_sink" ]; then
            found_next=1
        fi
    done < "$tmp_sinks"

    # If no next sink found, use the first one
    if [ -z "$next_sink" ]; then
        next_sink=$(head -n 1 "$tmp_sinks")
    fi

    # Clean up temporary file
    rm -f "$tmp_sinks"

    # Switch to next sink if found
    if [ -n "$next_sink" ] && [ "$next_sink" != "$current_sink" ]; then
        pactl set-default-sink "$next_sink"
        # Move all streams to new sink
        pactl list short sink-inputs | cut -f1 | while read -r stream; do
            pactl move-sink-input "$stream" "$next_sink"
        done

        # Send notification
        notify-send "Audio Output" "Switched audio output"
    fi
}

case $BLOCK_BUTTON in
    1) setsid -w -f "$TERMINAL" -e pulsemixer; pkill -RTMIN+10 "${STATUSBAR:-dwmblocks}" ;;
    2) wpctl set-mute @DEFAULT_SINK@ toggle ;;
    3) switch_to_next_sink; pkill -RTMIN+10 "${STATUSBAR:-dwmblocks}" ;;
    4) wpctl set-volume @DEFAULT_SINK@ 5%+ ;;
    5) wpctl set-volume @DEFAULT_SINK@ 5%- ;;
    6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# Get volume info
vol="$(wpctl get-volume @DEFAULT_AUDIO_SINK@)"

# If muted, print 🔇 and exit.
[ "$vol" != "${vol%\[MUTED\]}" ] && echo 🔇 && exit

vol="${vol#Volume: }"

split() {
    # For omitting the . without calling an external program.
    IFS=$2
    set -- $1
    printf '%s' "$@"
}

vol="$(printf "%.0f" "$(split "$vol" ".")")"

# Get current sink and its icon
current_sink=$(pactl get-default-sink)
icon=$(get_icon "$current_sink")

# Output volume status with icon
echo "$icon $vol%"
echo "$friendly_name ($current_sink)"

